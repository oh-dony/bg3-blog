---
import '../styles/global.css';
import { TIPOS, url } from '../tipos';
import { CLASSES, type Classe } from '../classes';
import { emblema } from '../lib/imagens';
import { postsPublicados, contarPorClasse } from '../lib/posts';

interface Props {
  titulo?: string;
  descricao?: string;
  /** Tipo já filtrado pela página (destaca o chip). */
  tipo?: keyof typeof TIPOS;
}
const { titulo, descricao = "Builds, parties, combos e talentos de Baldur's Gate 3, separados por classe.", tipo } = Astro.props;
const nomeSite = 'Grimório';
const atual = Astro.url.pathname;
const contagem = contarPorClasse(await postsPublicados());
const classesJs = Object.fromEntries(Object.entries(CLASSES).map(([k, c]) => [k, c.nome]));
const base = url('');
const ehInicio = atual === url('') || atual === url('').replace(/\/$/, '');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo ? `${titulo} · ${nomeSite}` : `${nomeSite} · Baldur's Gate 3`}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="app">
      <aside class="lateral">
        <a class="marca" href={url()}>Grimório <b>BG3</b></a>
        <a class="cl" href={url()} aria-current={ehInicio ? 'page' : undefined}><span class="cl-todas">✦</span><span class="so-largo">Todas as classes</span><span class="so-estreito">Todas</span></a>
        <a class="cl minha" href="#" data-minha hidden><img src="" alt="" width="28" height="28" /><span></span><small>★</small></a>
        <h4>Classes</h4>
        {(Object.entries(CLASSES) as [Classe, (typeof CLASSES)[Classe]][]).map(([slug, c]) => {
          const href = url(`classe/${slug}/`);
          return (
            <a class="cl" href={href} aria-current={atual.startsWith(href) ? 'page' : undefined} data-classe-link={slug}>
              {emblema(slug) && <img src={emblema(slug)} alt="" width="28" height="28" />}
              {c.nome}<small>{contagem[slug]}</small>
            </a>
          );
        })}
      </aside>

      <div class="principal">
        <div class="topo">
          <form class="busca" action={url()} role="search">
            <span aria-hidden="true">⌕</span>
            <input name="q" id="q" placeholder="Buscar build, talento, magia..." autocomplete="off" aria-label="Buscar" />
            <kbd>/</kbd>
          </form>
          <nav class="chips" aria-label="Tipos">
            <a class="chip" href={url()} data-t="" aria-current={!tipo ? 'true' : undefined}>Tudo</a>
            {Object.entries(TIPOS).map(([k, t]) => (
              <a class={`chip t-${k}`} href={url(`tipo/${k}/`)} data-t={k} aria-current={tipo === k ? 'true' : undefined}><i></i>{t.nome}</a>
            ))}
          </nav>
        </div>

        <main><slot /></main>

        <footer class="rodape">
          Site de fã, não oficial e gratuito. Baldur's Gate 3, ícones e retratos © Larian Studios.
          D&amp;D e Forgotten Realms são marcas da Wizards of the Coast. Nenhuma das duas endossa este site.
        </footer>
      </div>
    </div>

    <script is:inline define:vars={{ classesJs, base }}>
      const CHAVE = 'grimorio:classe';
      const ler = () => { try { const v = localStorage.getItem(CHAVE); return classesJs[v] ? v : null; } catch { return null; } };
      const gravar = (v) => { try { v ? localStorage.setItem(CHAVE, v) : localStorage.removeItem(CHAVE); } catch {} };

      // ---- "Estou jogando de": a classe salva aparece no topo da barra lateral ----
      function aplicar() {
        const minha = ler();
        const item = document.querySelector('[data-minha]');
        const origem = minha && document.querySelector(`[data-classe-link="${minha}"]`);
        item.hidden = !origem;
        if (origem) {
          item.href = origem.href;
          item.querySelector('img').src = origem.querySelector('img')?.src ?? '';
          item.querySelector('span').textContent = classesJs[minha];
          item.toggleAttribute('aria-current', origem.hasAttribute('aria-current'));
        }
        document.querySelectorAll('[data-marcar-classe]').forEach((btn) => {
          const sim = btn.dataset.marcarClasse === minha;
          btn.setAttribute('aria-pressed', String(sim));
          btn.textContent = sim ? `★ Jogando de ${classesJs[minha]}` : `Estou jogando de ${classesJs[btn.dataset.marcarClasse]}`;
        });
      }
      document.querySelectorAll('[data-marcar-classe]').forEach((btn) =>
        btn.addEventListener('click', () => { gravar(btn.getAttribute('aria-pressed') === 'true' ? null : btn.dataset.marcarClasse); aplicar(); }));
      aplicar();

      // ---- Busca e filtro por tipo, na própria página quando ela tem cards ----
      const grade = document.querySelector('[data-grade]');
      const campo = document.getElementById('q');
      const vazio = document.querySelector('[data-vazio]');
      let tipo = grade?.dataset.tipoFixo ?? '';
      const norm = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

      function filtrar() {
        if (!grade) return;
        const termo = norm(campo.value.trim());
        let visiveis = 0;
        grade.querySelectorAll('.card').forEach((c) => {
          const ok = (!tipo || c.dataset.tipo === tipo) && (!termo || norm(c.dataset.busca).includes(termo));
          c.hidden = !ok; if (ok) visiveis++;
        });
        if (vazio) vazio.hidden = visiveis > 0;
        document.querySelectorAll('.chip').forEach((ch) => ch.toggleAttribute('aria-current', ch.dataset.t === tipo));
      }
      if (grade && !grade.dataset.tipoFixo) {
        document.querySelectorAll('.chip').forEach((ch) => ch.addEventListener('click', (e) => {
          e.preventDefault(); tipo = ch.dataset.t; filtrar();
        }));
      }
      if (grade) {
        campo.addEventListener('input', filtrar);
        campo.form.addEventListener('submit', (e) => e.preventDefault());
        const q = new URLSearchParams(location.search).get('q');
        if (q) { campo.value = q; filtrar(); }
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== campo) { e.preventDefault(); campo.focus(); }
        if (e.key === 'Escape' && document.activeElement === campo) { campo.value = ''; filtrar(); campo.blur(); }
      });
    </script>
  </body>
</html>
