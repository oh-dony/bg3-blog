---
/** Posts como linhas: título, resumo, e de lado o tipo e as classes. */
import type { CollectionEntry } from 'astro:content';
import { TIPOS, url, formatarData } from '../tipos';
import { CLASSES, classesDoPost } from '../classes';
import { gravura, emblema } from '../lib/gravuras';
interface Props { posts: CollectionEntry<'posts'>[]; filtravel?: boolean; semTipo?: boolean }
const { posts, filtravel = false, semTipo = false } = Astro.props;
---
<ul class="posts" data-filtrar={filtravel ? '' : undefined} data-entra>
  {posts.map((post) => {
    const d = post.data;
    const classes = classesDoPost(post);
    const sub = d.membros ? d.membros.map((m) => m.nome).join(', ') : d.classe;
    const nomes = classes.length === 0 ? formatarData(d.data)
      : classes.length <= 3 ? classes.map((c) => CLASSES[c].nome).join(', ')
      : classes.length + ' classes';
    return (
      <li data-classes={classes.join(' ')}>
        <a class="post-linha" href={url(`posts/${post.id}/`)}>
          <span class:list={['post-mini', { emblema: d.tipo !== 'party' && classes[0] }]} aria-hidden="true"><img src={d.tipo !== 'party' && classes[0] ? emblema(classes[0]) : gravura('party')} alt="" width="120" height="150" loading="lazy" decoding="async" /></span>
          <h3>{d.titulo}{sub && <span class="sub">{sub}</span>}</h3>
          <p class="resumo">{d.resumo}</p>
          <p class="lado">
            {!semTipo && <>{TIPOS[d.tipo].singular}<br /></>}
            {nomes}
            <span class="seta" aria-hidden="true">→</span>
          </p>
        </a>
      </li>
    );
  })}
</ul>
