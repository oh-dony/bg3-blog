---
/** As 12 classes como tabela à direita; à esquerda, a gravura da classe sob o cursor. */
import { CLASSES, type Classe } from '../classes';
import { gravura, legenda, emblema } from '../lib/gravuras';
import { url } from '../tipos';
interface Props { contagem: Record<Classe, number> }
const { contagem } = Astro.props;
const lista = Object.entries(CLASSES) as [Classe, (typeof CLASSES)[Classe]][];
const primeira: Classe = 'paladino';
---
<div class="grade12 classes-corpo" data-tabela-classes>
  <figure class="classes-figura">
    <div class="quadro"><img src={gravura(primeira)} alt="" width="900" height="1150" loading="lazy" data-previa /></div>
    <figcaption data-previa-legenda>{legenda(primeira)}</figcaption>
  </figure>
  <ol class="tabela-classes" data-entra>
    {lista.map(([slug, c], i) => (
      <li style={`--i:${Math.min(i, 8)}`}>
        <a class:list={['linha-classe', { vazia: contagem[slug] === 0 }]} href={url(`classe/${slug}/`)}
          data-classe-linha={slug} data-gravura={gravura(slug)} data-legenda={legenda(slug)}>
          <strong><img class="emblema-mini" src={emblema(slug)} alt="" width="48" height="48" loading="lazy" />{c.nome}</strong>
          <span class="papel">{c.papel}</span>
          <span class="num">{contagem[slug] === 0 ? 'nada ainda' : contagem[slug] === 1 ? '1 post' : `${contagem[slug]} posts`}<span class="seta" aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ol>
</div>
