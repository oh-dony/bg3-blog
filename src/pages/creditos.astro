---
import Base from '../layouts/Base.astro';
import { CREDITOS, gravura } from '../lib/gravuras';
import { CLASSES, type Classe } from '../classes';
const nomeDe = (k: string) => (k === 'party' ? 'Parties' : CLASSES[k as Classe]?.nome ?? k);
---
<Base titulo="Créditos" descricao="De onde vêm as gravuras do Grimório.">
  <section class="cabeca" data-entra>
    <h1>Créditos</h1>
    <p class="apoio">As gravuras são dos séculos XV a XVII, em domínio público, e cada uma representa uma classe. Nenhuma é arte do jogo.</p>
  </section>
  <ul class="creditos" data-entra>
    {Object.entries(CREDITOS).map(([k, c]) => (
      <li>
        <div class="quadro"><img src={gravura(k)} alt="" width="900" height="1150" loading="lazy" decoding="async" /></div>
        <p><strong>{nomeDe(k)}</strong>“{c.title}”, {c.creator}, {c.date}. {c.license}, via <a href={c.page}>{c.via}</a>.</p>
      </li>
    ))}
  </ul>
</Base>
