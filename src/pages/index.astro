---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { postsPublicados } from '../lib/posts';
import { emblema } from '../lib/imagens';

const posts = await postsPublicados();
---
<Base>
  <section class="banner">
    <img src={emblema('paladino')} alt="" width="96" height="96" />
    <div>
      <h1>Builds, parties e talentos de BG3</h1>
      <p>Escolha a sua classe ou busque direto.</p>
    </div>
    <div class="stats">
      <div><b>{posts.length}</b><span>anotações</span></div>
      <div><b>12</b><span>classes</span></div>
    </div>
  </section>

  <div class="grade" data-grade>
    {posts.map((post) => <Card post={post} />)}
  </div>
  <p class="vazio" data-vazio hidden>Nada encontrado.</p>
</Base>
