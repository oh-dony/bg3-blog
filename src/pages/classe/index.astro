---
import Base from '../../layouts/Base.astro';
import { postsPublicados, contarPorClasse } from '../../lib/posts';
import { emblema } from '../../lib/imagens';
import { CLASSES, type Classe } from '../../classes';
import { url } from '../../tipos';
const contagem = contarPorClasse(await postsPublicados());
---
<Base titulo="Classes" descricao="As doze classes de Baldur's Gate 3 e o que o Grimório tem pra cada uma.">
  <section class="banner">
    <div><h1>Classes</h1><p>Escolha a sua pra ver tudo o que serve pra ela.</p></div>
  </section>
  <div class="grade-classes">
    {(Object.entries(CLASSES) as [Classe, (typeof CLASSES)[Classe]][]).map(([slug, c]) => (
      <a class="classe-card" href={url(`classe/${slug}/`)}>
        {emblema(slug) && <img src={emblema(slug)} alt="" width="64" height="64" loading="lazy" />}
        <div><h3>{c.nome}</h3><p>{c.papel}</p></div>
        <small>{contagem[slug]}</small>
      </a>
    ))}
  </div>
</Base>
