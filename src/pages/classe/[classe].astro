---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { postsPublicados } from '../../lib/posts';
import { emblema } from '../../lib/imagens';
import { CLASSES, classesDoPost, type Classe } from '../../classes';
import { TIPOS } from '../../tipos';

export function getStaticPaths() {
  return Object.keys(CLASSES).map((classe) => ({ params: { classe } }));
}
const slug = Astro.params.classe as Classe;
const c = CLASSES[slug];
const posts = (await postsPublicados()).filter((p) => classesDoPost(p).includes(slug));
const conta = (t: string) => posts.filter((p) => p.data.tipo === t).length;
---
<Base titulo={c.nome} descricao={`Builds, parties, combos e talentos para ${c.nome} em Baldur's Gate 3.`}>
  <section class="banner">
    {emblema(slug) && <img src={emblema(slug)} alt="" width="96" height="96" />}
    <div>
      <h1>{c.nome}</h1>
      <p>{c.papel} · {c.atributo}</p>
      <button class="marcar" type="button" data-marcar-classe={slug} aria-pressed="false">Estou jogando de {c.nome}</button>
    </div>
    <div class="stats">
      {(['build', 'party', 'talento'] as const).map((t) => <div><b>{conta(t)}</b><span>{TIPOS[t].nome}</span></div>)}
    </div>
  </section>

  <div class="grade" data-grade>
    {posts.map((post) => <Card post={post} />)}
  </div>
  <p class="vazio" data-vazio hidden={posts.length > 0}>
    {posts.length === 0 ? <>Nada pra {c.nome} ainda. Num post novo, coloque <code>classes: [{slug}]</code> no topo.</> : 'Nada encontrado.'}
  </p>
</Base>
