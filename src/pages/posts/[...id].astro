---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import Retrato from '../../components/Retrato.astro';
import Party from '../../components/Party.astro';
import { postsPublicados } from '../../lib/posts';
import ListaPosts from '../../components/ListaPosts.astro';
import { gravura, legenda, emblema } from '../../lib/gravuras';
import { TIPOS, url, formatarData } from '../../tipos';
import { CLASSES, classesDoPost } from '../../classes';

export async function getStaticPaths() {
  const posts = await postsPublicados();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const t = TIPOS[d.tipo];
const { Content } = await render(post);
const classes = classesDoPost(post);
const imagem = d.tipo === 'party' ? 'party' : classes[0];
const temFicha = true;
// Leia também: posts que dividem mais classes com este.
const todos = await postsPublicados();
const relacionados = todos
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, n: classesDoPost(p).filter((c) => classes.includes(c)).length }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n)
  .slice(0, 3)
  .map((x) => x.p);
---
<Base titulo={d.titulo} descricao={d.resumo}>
  <article class="post">
    <header class="post-cabeca" data-entra>
      <h1>{d.titulo}</h1>
      {d.resumo && <p class="apoio">{d.resumo}</p>}
    </header>

    {d.membros && d.membros.length > 0 && (
      <section class="formacao">
        <h2>A formação</h2>
        <Party membros={d.membros} />
      </section>
    )}

    <div class="grade12 post-corpo">
      <!-- Em posts .mdx, <Icone> e <Retrato> funcionam sem import -->
      <div class="conteudo" data-entra><Content components={{ Icone, Retrato }} /></div>
      {(temFicha || imagem) && (
        <aside data-entra>
          {temFicha && (
            <dl class="ficha">
              {classes.length > 0 && (
                <div><dt>Serve para</dt><dd class="para-classes">
                  {classes.map((c) => <a href={url(`classe/${c}/`)}><img class="emblema-mini" src={emblema(c)} alt="" width="48" height="48" loading="lazy" />{CLASSES[c].nome}</a>)}
                </dd></div>
              )}
              {d.classe && <div><dt>Classe</dt><dd>{d.classe}</dd></div>}
              {d.raca && <div><dt>Raça</dt><dd>{d.raca}</dd></div>}
              {d.talentos && <div><dt>Talentos</dt><dd>{d.talentos.join(', ')}</dd></div>}
              {d.atributos && (
                <div>
                  <dt>Atributos</dt>
                  <dd><ul class="atributos">
                    {Object.entries(d.atributos).map(([k, v]) => <li><span>{k}</span><strong>{v}</strong></li>)}
                  </ul></dd>
                </div>
              )}
            </dl>
          )}
          {imagem && d.tipo !== 'party' && (
            <figure class="post-gravura">
              <div class="quadro"><img src={gravura(imagem)} alt={legenda(imagem)} width="900" height="1150" loading="lazy" decoding="async" /></div>
              <figcaption>{legenda(imagem)}</figcaption>
            </figure>
          )}
        </aside>
      )}
    </div>
    <p class="post-tags"><a href={url(`tipo/${d.tipo}/`)}>{t.singular}</a>, anotado em {formatarData(d.data)}.{d.tags.length > 0 && ` Marcado como: ${d.tags.join(', ')}.`}</p>
  </article>

  {relacionados.length > 0 && (
    <section class="secao">
      <h2 class="titulo-secao">Leia também</h2>
      <ListaPosts posts={relacionados} />
    </section>
  )}
</Base>
