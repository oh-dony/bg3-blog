---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import Retrato from '../../components/Retrato.astro';
import Party from '../../components/Party.astro';
import Card from '../../components/Card.astro';
import { postsPublicados } from '../../lib/posts';
import { emblema } from '../../lib/imagens';
import { TIPOS, url, formatarData } from '../../tipos';
import { CLASSES, classesDoPost } from '../../classes';

export async function getStaticPaths() {
  const posts = await postsPublicados();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const classes = classesDoPost(post);

// Leia também: os posts que dividem mais classes com este.
const relacionados = (await postsPublicados())
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, n: classesDoPost(p).filter((c) => classes.includes(c)).length }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n)
  .slice(0, 3)
  .map((x) => x.p);
---
<Base titulo={d.titulo} descricao={d.resumo} tipo={d.tipo}>
  <article class={`post t-${d.tipo}`}>
    <header class="post-cab">
      <div class="card-cab"><a href={url(`tipo/${d.tipo}/`)}>{TIPOS[d.tipo].singular}</a><time datetime={d.data.toISOString()}>{formatarData(d.data)}</time></div>
      <h1>{d.titulo}</h1>
      {d.resumo && <p>{d.resumo}</p>}
      {d.tags.length > 0 && <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>}
    </header>

    {d.membros && d.membros.length > 0 && (
      <section class="bloco">
        <h2>A formação</h2>
        <Party membros={d.membros} />
      </section>
    )}

    <div class="post-corpo">
      <!-- Em posts .mdx, <Icone> e <Retrato> funcionam sem import -->
      <div class="conteudo"><Content components={{ Icone, Retrato }} /></div>

      <aside class="ficha">
        {classes.length > 0 && (
          <div>
            <h4>Serve para</h4>
            <div class="ficha-classes">
              {classes.map((c) => (
                <a href={url(`classe/${c}/`)}>
                  {emblema(c) && <img src={emblema(c)} alt="" width="26" height="26" />}{CLASSES[c].nome}
                </a>
              ))}
            </div>
          </div>
        )}
        {d.classe && <div><h4>Classe</h4><p>{d.classe}</p></div>}
        {d.raca && <div><h4>Raça</h4><p>{d.raca}</p></div>}
        {d.talentos && <div><h4>Talentos</h4><ul>{d.talentos.map((t) => <li>{t}</li>)}</ul></div>}
        {d.atributos && (
          <div>
            <h4>Atributos</h4>
            <ul class="atributos">
              {Object.entries(d.atributos).map(([k, v]) => <li><span>{k}</span><b>{v}</b></li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>

  {relacionados.length > 0 && (
    <section class="bloco">
      <h2>Leia também</h2>
      <div class="grade">{relacionados.map((p) => <Card post={p} />)}</div>
    </section>
  )}
</Base>
